# Storage for the wishes wall (Upstash Redis).
#
# On Vercel you do not need to set these by hand: add Upstash Redis from the
# project's Storage tab and Vercel injects them for you. Copy them into
# .env.local only if you want the wall working on your own machine.
#
# Until they exist the site still runs — the wishes wall shows its empty state
# and the form politely says wishes are not open yet.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: set once a custom domain is attached, so WhatsApp and iMessage link
# previews point at the right place.
# NEXT_PUBLIC_SITE_URL=https://jesmeandvibin.com
