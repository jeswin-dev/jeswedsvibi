# Google Sheets credentials for RSVP replies and wishes.
# Copy to .env.local for local development, and add the same three variables in
# Vercel under Project → Settings → Environment Variables.
#
# Until these are set, the site still runs: the RSVP form tells guests to call
# or WhatsApp instead, and the wishes wall stays closed.
# See the "Collecting RSVPs" section of README.md for how to obtain them.

GOOGLE_SERVICE_ACCOUNT_EMAIL=invitation-writer@your-project.iam.gserviceaccount.com

# The full private key from the service account JSON, in double quotes,
# with the \n escapes left exactly as they appear in the file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The long id from the sheet URL:
# docs.google.com/spreadsheets/d/THIS_PART/edit
RSVP_SHEET_ID=
